
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum BookingStatus {
  PENDING
  REVIEWED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EnquiryStatus {
  NEW
  REVIEWED
  QUOTED
  CLOSED
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())
}

model ProductCategory {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Product {
  id           String          @id @default(cuid())
  slug         String          @unique
  name         String
  categoryId   String
  category     ProductCategory @relation(fields: [categoryId], references: [id])
  description  String
  features     String[]
  specs        Json?
  sizes        String?
  fuelType     String?
  materials    String?
  priceKes     Int?
  availability String          @default("Available on request")
  installation Boolean         @default(true)
  warranty     String?
  featured     Boolean         @default(false)
  visible      Boolean         @default(true)
  isSample     Boolean         @default(false)
  images       ProductImage[]
  enquiries    Enquiry[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  position  Int     @default(0)
}

model Service {
  id              String  @id @default(cuid())
  slug            String  @unique
  name            String
  description     String
  benefits        String[]
  locations       String  @default("Workshop, mobile visit or on-site")
  position        Int     @default(0)
  visible         Boolean @default(true)
  icon            String  @default("Wrench")
  imageUrl        String?
  longDescription String?
  faqs            Json?
}

model Booking {
  id            String        @id @default(cuid())
  reference     String        @unique
  fullName      String
  phone         String
  email         String?
  county        String
  town          String
  service       String
  date          DateTime
  time          String
  method        String
  description   String
  notes         String?
  attachments   String[]
  status        BookingStatus @default(PENDING)
  internalNotes String?
  termsAcceptedAt DateTime?
  privacyAcknowledgedAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, createdAt])
}

model Questionnaire {
  id          String        @id @default(cuid())
  reference   String        @unique
  type        String
  fullName    String
  phone       String
  email       String?
  county      String
  town        String
  answers     Json
  attachments String[]
  status      EnquiryStatus @default(NEW)
  quoteNotes  String?
  termsAcceptedAt DateTime?
  privacyAcknowledgedAt DateTime?
  createdAt   DateTime      @default(now())

  @@index([status, createdAt])
}

model Enquiry {
  id        String        @id @default(cuid())
  fullName  String
  phone     String
  email     String?
  message   String
  productId String?
  product   Product?      @relation(fields: [productId], references: [id])
  status    EnquiryStatus @default(NEW)
  termsAcceptedAt DateTime?
  privacyAcknowledgedAt DateTime?
  createdAt DateTime      @default(now())
}

model GalleryProject {
  id          String         @id @default(cuid())
  title       String
  category    String
  description String?
  location    String?
  featured    Boolean        @default(false)
  images      GalleryImage[]
  createdAt   DateTime       @default(now())
}

model GalleryImage {
  id        String         @id @default(cuid())
  projectId String
  project   GalleryProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  kind      String         @default("PHOTO")
  position  Int            @default(0)
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  body      String
  location  String?
  createdAt DateTime @default(now())
}

model SiteSettings {
  id                    Int      @id @default(1)
  businessName          String
  phone1                String
  phone2                String?
  email                 String?
  location              String
  address               String?
  mapEmbedUrl           String?
  tiktokUrl             String?
  hours                 String   @default("24 hours")
  story                 String?
  mission               String?
  vision                String?
  foundedNote           String?
  servicesHeroImage     String?
  servicesHeroVideoUrl  String?
  servicesIntroImages   String[] @default([])
  servicesStatLabel     String?
  servicesStatValue     String?
  updatedAt             DateTime @updatedAt
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

model LegalPolicy {
  slug      String                @id
  title     String
  content   String                @db.Text
  revision  Int                   @default(1)
  updatedAt DateTime              @updatedAt
  revisions LegalPolicyRevision[]
}

model LegalPolicyRevision {
  id        String      @id @default(cuid())
  policySlug String
  title     String
  content   String      @db.Text
  revision  Int
  changedBy String
  createdAt DateTime    @default(now())
  policy    LegalPolicy @relation(fields: [policySlug], references: [slug], onDelete: Cascade)

  @@unique([policySlug, revision])
  @@index([policySlug, createdAt])
}

model CookieCategory {
  key         String   @id
  title       String
  description String   @db.Text
  essential   Boolean  @default(false)
  enabled     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}
